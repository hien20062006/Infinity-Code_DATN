      <column caption='Gia_tri_TB_moi_san_pham' datatype='real' name='[Calculation_1444242564153344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([tong_gia_tri_hang])&#13;&#10;/&#13;&#10;SUM([so_luong_san_pham])' />
