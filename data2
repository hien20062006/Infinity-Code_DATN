import requests
import pandas as pd
import time
url = "https://provinces.open-api.vn/api/?depth=3"
response = requests.get(url)
if response.status_code != 200:
    raise Exception("Không lấy được dữ liệu từ API")
data = response.json()
rows = []
for tinh in data:
    ten_tinh = tinh["name"]
    ma_tinh = tinh["code"]
    for huyen in tinh["districts"]:
        ten_huyen = huyen["name"]
        ma_huyen = huyen["code"]
        for xa in huyen["wards"]:
            ten_xa = xa["name"]
            ma_xa = xa["code"]
            rows.append({
                "ma_tinh": ma_tinh,
                "ten_tinh": ten_tinh,
                "ma_huyen": ma_huyen,
                "ten_huyen": ten_huyen,
                "ma_xa": ma_xa,
                "ten_xa": ten_xa
            })
df = pd.DataFrame(rows)
df.to_excel(
    "dia_chi_tinh_huyen_xa_viet_nam.xlsx",
    index=False
)

print("Đã tạo file dia_chi_tinh_huyen_xa_viet_nam.xlsx")
print("Số dòng:", len(df))
print(df.head())
