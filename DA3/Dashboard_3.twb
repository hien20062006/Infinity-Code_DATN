            <column caption='Thi_Phan_Dau_Ky' datatype='real' name='[Calculation_0556111782047748]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Ten_Thuong_Hieu] :&#13;&#10;    SUM(&#13;&#10;        IF [Nam] = [Calculation_0556111781867522]&#13;&#10;        THEN [Thi_Phan]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Thi_Phan_Cuoi_Ky' datatype='real' name='[Calculation_0556111782092805]' role='measure' type='quantitative'>
