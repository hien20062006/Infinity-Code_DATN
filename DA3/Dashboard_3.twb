          <datasource-dependencies datasource='federated.16ehif51dluf0k1112yab0jsasbp'>
            <column caption='Thi_Phan_Theo_Nam' datatype='real' name='[Calculation_0556111781646337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Nam], [Ten_Thuong_Hieu] :&#13;&#10;    SUM([Thi_Phan])&#13;&#10;}' />
            </column>
            <column caption='Nam_Dau_Ky' datatype='integer' name='[Calculation_0556111781867522]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Ten_Thuong_Hieu] :&#13;&#10;    MIN([Nam])&#13;&#10;}' />
            </column>
